# PostgreSQL Configuration
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_pass
POSTGRES_DB=jarvis_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_pass@localhost:5432/jarvis_db

# LLM Providers Configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
GENERIC_OPENAI_BASE_URL=
GENERIC_OPENAI_API_KEY=

# Task-to-Model Routing Defaults
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o

LLM_JOURNAL_ANALYSIS_PROVIDER=openai
LLM_JOURNAL_ANALYSIS_MODEL=gpt-4o-mini

LLM_PLAN_GENERATION_PROVIDER=openai
LLM_PLAN_GENERATION_MODEL=gpt-4o

LLM_CHAT_PROVIDER=openai
LLM_CHAT_MODEL=gpt-4o

# Embeddings Config
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Fallback Configuration
LLM_ENABLE_FALLBACK=true
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_MODEL=llama3.1:8b
